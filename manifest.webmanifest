{
  "id": "./",
  "name": "EventGo — Événements à Conakry",
  "short_name": "EventGo",
  "description": "Découvrez et réservez les concerts, ateliers, expositions et rencontres de Conakry. Retrouvez vos billets même hors ligne.",
  "lang": "fr",

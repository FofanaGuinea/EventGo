  "categories": ["entertainment", "lifestyle", "events"],
  "icons": [
    { "src": "assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "assets/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "assets/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "assets/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "screenshots": [
    { "src": "assets/screens/wide-home.png", "sizes": "1280x720", "type": "image/png", "form_factor": "wide", "label": "Accueil : les événements de Conakry" },
    { "src": "assets/screens/wide-event.png", "sizes": "1280x720", "type": "image/png", "form_factor": "wide", "label": "Fiche événement et réservation" },
    { "src": "assets/screens/narrow-home.png", "sizes": "540x960", "type": "image/png", "form_factor": "narrow", "label": "Accueil sur téléphone" },
    { "src": "assets/screens/narrow-explorer.png", "sizes": "540x960", "type": "image/png", "form_factor": "narrow", "label": "Explorer et filtrer" }
  ],
  "shortcuts": [
    { "name": "Explorer", "short_name": "Explorer", "url": "explorer.html", "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Mes billets", "short_name": "Billets", "url": "billets.html", "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Carte des événements", "short_name": "Carte", "url": "carte.html", "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
